# Vanguard System Monitor — environment variables
# Copy this file to .env and fill in values before running locally with Docker.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required for /api/trigger, /api/summary/latest, and /api/ingest when an API
# key is configured. Set a strong random value when hosting publicly.
VANGUARD_API_KEY=your-secret-key-here

# ── Cloud mode ────────────────────────────────────────────────────────────────
# Set to 1 when the backend is deployed to the cloud.
# Disables /api/trigger (collector must POST directly to /api/ingest instead).
CLOUD_MODE=1

# ── Database ──────────────────────────────────────────────────────────────────
# Override the SQLite database path. Useful in containers where the database
# should live on a persistent volume.
# Default (when unset): data/vanguard_monitor.db relative to the repo root.
VANGUARD_DB_PATH=/app/data/vanguard_monitor.db

# ── Server ────────────────────────────────────────────────────────────────────
# Port the server listens on. Cloud platforms (Render, Railway, Fly) inject
# this automatically; you only need to set it for local Docker runs.
PORT=8000
